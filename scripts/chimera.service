[Unit]
Description=CHIMERA Crypto Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jo
WorkingDirectory=/home/jo/ChimeraCrypto
ExecStart=/home/jo/ChimeraCrypto/build/chimera
ExecStop=/bin/kill -SIGINT $MAINPID
TimeoutStopSec=10
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
