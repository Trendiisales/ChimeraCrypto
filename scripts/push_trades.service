[Unit]
Description=CHIMERA trade log auto-pusher
After=network.target

[Service]
Type=simple
User=jo
WorkingDirectory=/home/jo/ChimeraCrypto
ExecStart=/home/jo/ChimeraCrypto/scripts/push_trades.sh
Restart=no

[Install]
# WantedBy intentionally omitted — must be started manually with: systemctl start push_trades
# Do NOT run: systemctl enable push_trades
