[Unit]
Description=CHIMERA Crypto Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jo
WorkingDirectory=/home/jo/ChimeraCrypto
ExecStart=/home/jo/ChimeraCrypto/build/chimera
ExecStop=/bin/kill -SIGINT $MAINPID
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
# WantedBy intentionally omitted — must be started manually with: systemctl start chimera
# Do NOT run: systemctl enable chimera
